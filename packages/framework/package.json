{
  "name": "@bibi2400/electron-angular-framework",
  "version": "2.5.10",
  "description": "Angular + Electron + SQLite desktop application framework",
  "author": "bibi",
  "license": "UNLICENSED",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/bibi2400/db-app-sample.git",
    "directory": "packages/framework"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "default": "./dist/electron/index.js"
    },
    "./angular": {
      "types": "./src/angular/index.ts",
      "default": "./src/angular/index.ts"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "default": "./dist/preload/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./styles/theme": "./src/angular/styles/_theme.scss",
    "./scripts/electron-dev": "./src/cli/scripts/electron-dev.js",
    "./scripts/dev": "./src/cli/scripts/dev.js"
  },
  "typesVersions": {
    "*": {
      "electron": [
        "dist/electron/index.d.ts"
      ],
      "angular": [
        "src/angular/index.ts"
      ],
      "preload": [
        "dist/preload/index.d.ts"
      ],
      "shared": [
        "dist/shared/index.d.ts"
      ]
    }
  },
  "bin": {
    "eaf": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "src/angular/",
    "src/shared/",
    "src/cli/scripts/",
    "src/cli/build/",
    "src/cli/templates/"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch"
  },
  "peerDependencies": {
    "@angular/core": ">=21.0.0",
    "@angular/router": ">=21.0.0",
    "@angular/common": ">=21.0.0",
    "@angular/material": ">=21.0.0",
    "@angular/cdk": ">=21.0.0",
    "@angular/animations": ">=21.0.0",
    "@angular/platform-browser": ">=21.0.0",
    "electron": ">=39.0.0",
    "rxjs": ">=7.0.0"
  },
  "dependencies": {
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.3",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.3",
    "electron-window-state": "^5.0.3",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {}
}
