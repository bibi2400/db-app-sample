{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "./dist-electron",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "{{PKG}}/electron": [
        "node_modules/{{PKG}}/dist/electron/index"
      ],
      "{{PKG}}/preload": [
        "node_modules/{{PKG}}/dist/preload/index"
      ]
    },
    "module": "commonjs",
    "target": "es2020",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "./**/*.ts"
  ]
}
