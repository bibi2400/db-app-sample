{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "./dist-electron",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@bibi2400/electron-angular-framework/electron": ["packages/framework/dist/electron/index"],
      "@bibi2400/electron-angular-framework/preload": ["packages/framework/dist/preload/index"]
    },
    "module": "commonjs",
    "target": "es2020",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "./**/*.ts"
  ]
}