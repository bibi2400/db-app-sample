{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-electron",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"]
    },
    "module": "commonjs",
    "target": "es2020",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "./**/*.ts",
    "../shared/**/*.ts"
  ]
}